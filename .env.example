# Copy to .env.local (never commit real keys)
# Supabase — paste from Supabase Dashboard > Settings > API
# (NEXT_PUBLIC_ is required: the browser client reads these names.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Vercel dashboard uses the same two values, entered in the page.
